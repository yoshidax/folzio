<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Copy in the context menu (multiple items). %2$@ is the formatted count -->
  <key>context.copy.multiple</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@value@</string>
    <key>value</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>Copy %2$@ Item</string>
      <key>other</key>
      <string>Copy %2$@ Items</string>
    </dict>
  </dict>
  <!-- Count phrase in the search bar. %2$@ is the formatted count -->
  <key>search.bar.count</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@value@</string>
    <key>value</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>%2$@ item</string>
      <key>other</key>
      <string>%2$@ items</string>
    </dict>
  </dict>
  <!-- Count phrase in the search bar (truncated at the limit). %2$@ is the total count and %3$@ is the displayed count -->
  <key>search.bar.countLimited</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@value@</string>
    <key>value</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>Showing %3$@ of %2$@ item</string>
      <key>other</key>
      <string>Showing %3$@ of %2$@ items</string>
    </dict>
  </dict>
  <!-- Title for the copy confirmation. The wording changes with the count, but the count is not shown -->
  <key>dialog.confirm.copy</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@value@</string>
    <key>value</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>Copy this item?</string>
      <key>other</key>
      <string>Copy these items?</string>
    </dict>
  </dict>
  <!-- Title for the move confirmation. The wording changes with the count, but the count is not shown -->
  <key>dialog.confirm.move</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@value@</string>
    <key>value</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>Move this item?</string>
      <key>other</key>
      <string>Move these items?</string>
    </dict>
  </dict>
</dict>
</plist>
